{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marcel-trading-ia",
  "main": "worker.js",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "upload_source_maps": true
}
